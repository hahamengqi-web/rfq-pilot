# Docker-only credentials. Copy to deploy/docker/.env and replace every value.
# This file does not configure NanoClaw and does not point at any local database.

DOCKER_MYSQL_PORT=3307
DOCKER_MYSQL_DATABASE=nanoclaw_docker
DOCKER_MYSQL_USER=nanoclaw_docker
DOCKER_MYSQL_PASSWORD=replace-with-a-long-random-password
DOCKER_MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password

DOCKER_POSTGRES_PORT=5433
DOCKER_POSTGRES_DATABASE=nanoclaw_vector_docker
DOCKER_POSTGRES_USER=nanoclaw_vector_docker
DOCKER_POSTGRES_PASSWORD=replace-with-a-long-random-password

DOCKER_ELASTIC_PORT=9201
DOCKER_ELASTIC_PASSWORD=replace-with-a-long-random-password

DOCKER_MILVUS_PORT=19530
DOCKER_MILVUS_BACKUP_PORT=18080
DOCKER_MINIO_ROOT_USER=nanoclaw_minio
DOCKER_MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
# 镜像仓库不可达但本地已有 MinIO 镜像时，可设置 DOCKER_MINIO_IMAGE 和 DOCKER_MINIO_PULL_POLICY=never。
# 默认从 MinIO 官方 Quay 仓库拉取固定版本。
DOCKER_MINIO_IMAGE=quay.io/minio/minio:RELEASE.2024-12-18T13-15-44Z
DOCKER_MINIO_PULL_POLICY=missing
DOCKER_MILVUS_ROOT_PASSWORD=replace-with-a-different-long-random-password
DOCKER_MILVUS_APP_USER=nanoclaw_rag
DOCKER_MILVUS_APP_PASSWORD=replace-with-another-long-random-password
