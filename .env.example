# RFQPilot 环境变量示例
#
# 使用方法：
# 1. 在项目根目录执行：Copy-Item .env.example .env
# 2. 打开 .env，先填写“基础运行”中的 NANOCLAW_API_KEY。
# 3. 不使用某项高级功能时，保持这里的默认值或留空即可。
#
# 安全提醒：.env 会保存真实密钥，已经被 Git 忽略。不要把自己的 .env 发给别人。

NANOCLAW_STORAGE_PROFILE=local

# =============================================================================
# 一、基础运行（第一次运行只需要看这一段）
# =============================================================================

# 【必填】大模型 API 密钥。当前 config.json 默认使用硅基流动兼容接口。
NANOCLAW_API_KEY=

# 主页面：http://127.0.0.1:8765/
NANOCLAW_WEB_HOST=127.0.0.1
NANOCLAW_WEB_PORT=8765

# Docker Compose 发布端口。默认只监听服务器回环地址，由 Nginx/Caddy
# 反向代理；不要为了省事把内部工作台直接暴露到公网。
NANOCLAW_BIND_ADDRESS=127.0.0.1
NANOCLAW_WEB_PUBLIC_PORT=8765

# 独立工作台默认关闭。开启后访问：http://127.0.0.1:8767/
NANOCLAW_WORKSPACE_WEB_ENABLED=true
NANOCLAW_WORKSPACE_WEB_HOST=127.0.0.1
NANOCLAW_WORKSPACE_WEB_PORT=8767

# 内部工作台功能开关。普通使用保持 true。
WEB_MULTI_CONVERSATION_ENABLED=true
KNOWLEDGE_ADMIN_ENABLED=true
WORKFLOW_EVENTS_ENABLED=true

# =============================================================================
# 二、飞书和 QQ 机器人（不用机器人时保持空白）
# =============================================================================

NANOCLAW_FEISHU_APP_ID=
NANOCLAW_FEISHU_APP_SECRET=

NANOCLAW_QQ_APP_ID=
NANOCLAW_QQ_APP_SECRET=

# =============================================================================
# 三、知识库向量检索
# =============================================================================

# 产品知识库使用 Milvus 持久向量索引。
RAG_METADATA_BACKEND=manifest
NANOCLAW_KNOWLEDGE_FILE_ROOT=workspace/knowledge_base
RAG_VECTOR_BACKEND=milvus
RAG_VECTOR_DIMENSIONS=1024
# 未启用 Elasticsearch/MySQL 时，父块使用工作区文件作为本地回退。
RAG_PARENT_STORE_PATH=workspace/knowledge_base/parents

# pgvector 连接信息。仅当 RAG_VECTOR_BACKEND=pgvector 时需要填写。
RAG_PGVECTOR_HOST=
RAG_PGVECTOR_PORT=5433
RAG_PGVECTOR_DATABASE=
RAG_PGVECTOR_USER=
RAG_PGVECTOR_PASSWORD=
RAG_PGVECTOR_SSLMODE=prefer
RAG_PGVECTOR_CONNECT_TIMEOUT_SECONDS=5

# Milvus 连接信息。仅当 RAG_VECTOR_BACKEND=milvus 时需要填写。
RAG_MILVUS_URI=http://127.0.0.1:19530
RAG_MILVUS_TOKEN=
RAG_MILVUS_DATABASE=nanoclaw_vector_docker
RAG_MILVUS_COLLECTION_ALIAS=trade_knowledge_active
RAG_MILVUS_CONNECT_TIMEOUT_SECONDS=5

# Milvus 管理令牌只供建库、切换 Alias 等管理命令使用，不要交给普通应用进程。
RAG_MILVUS_ADMIN_TOKEN=

# 健康检查、指标接口等受保护接口使用的令牌。只在部署监控时填写。
RAG_OBSERVABILITY_TOKEN=

# =============================================================================
# 四、知识库关键词检索
# =============================================================================

# 产品知识库使用 Elasticsearch 关键词索引。
RAG_KEYWORD_BACKEND=elasticsearch

# 仅当 RAG_KEYWORD_BACKEND=elasticsearch 时需要填写。
RAG_ELASTICSEARCH_URL=http://127.0.0.1:9201
RAG_ELASTICSEARCH_USERNAME=elastic
RAG_ELASTICSEARCH_PASSWORD=
RAG_ELASTICSEARCH_INDEX=trade_knowledge_child_v1
# 父块单独持久化，不能与上面的子块关键词索引同名。
RAG_ELASTICSEARCH_PARENT_INDEX=trade_knowledge_parent_v1
RAG_ELASTICSEARCH_TIMEOUT_SECONDS=10

# =============================================================================
# 五、业务数据库
# =============================================================================

# 询盘、背调运行记录、步骤和证据以 MySQL 为权威存储。
BUSINESS_DATABASE_BACKEND=mysql
TRADE_OPS_MYSQL_HOST=127.0.0.1
TRADE_OPS_MYSQL_PORT=3306
TRADE_OPS_MYSQL_DATABASE=trade_ops
TRADE_OPS_MYSQL_USER=
TRADE_OPS_MYSQL_PASSWORD=

# 邮件投递记录保留天数，以及治理日志中记录的操作人名称。
NANOCLAW_EMAIL_DELIVERY_RETENTION_DAYS=90
NANOCLAW_EMAIL_GOVERNANCE_ACTOR=

# =============================================================================
# 六、历史客户资料与客户数据
# =============================================================================

# 对外部署时填写完整 HTTPS 地址；只在本机运行时留空。
NANOCLAW_CUSTOMER_PORTAL_PUBLIC_URL=
NANOCLAW_CUSTOMER_IDENTITY_FILE=prompts/customer_consultation.md

# 客户会话与公开记忆使用独立目录，不要改成内部工作区目录。
NANOCLAW_CONVERSATION_BACKEND=local
NANOCLAW_CUSTOMER_SESSION_DIR=workspace/customer_sessions
NANOCLAW_CUSTOMER_MEMORY_ENABLED=true
NANOCLAW_CUSTOMER_MEMORY_FILE=workspace/customer_memory/PUBLIC_MEMORY.md

# 客户产品咨询 Agent。Redis 留空时使用进程内缓存；Docker Compose 会自动注入 Redis 地址。
NANOCLAW_CUSTOMER_PRODUCT_LANGCHAIN_ENABLED=true
NANOCLAW_CUSTOMER_PRODUCT_REDIS_URL=
NANOCLAW_CUSTOMER_PRODUCT_CACHE_PREFIX=nanoclaw:customer-product
NANOCLAW_CUSTOMER_PRODUCT_CACHE_TTL_SECONDS=300
NANOCLAW_CUSTOMER_PRODUCT_RATE_LIMIT_PER_MINUTE=60
NANOCLAW_CUSTOMER_PRODUCT_DATA_VERSION=products-v1
NANOCLAW_CUSTOMER_PRODUCT_DEFAULT_LEVEL=standard
NANOCLAW_CUSTOMER_PRODUCT_DEFAULT_REGION=GLOBAL
NANOCLAW_CUSTOMER_PRODUCT_DEFAULT_CURRENCY=USD

# Customer-service Harness: Redis short-term memory and controlled tool execution.
# 15 older turns are summarized; the newest 5 turns stay verbatim.
NANOCLAW_CUSTOMER_HARNESS_REDIS_URL=redis://127.0.0.1:6379/4
NANOCLAW_CUSTOMER_HARNESS_REDIS_PREFIX=nanoclaw:customer-harness
NANOCLAW_CUSTOMER_HARNESS_SESSION_TTL_SECONDS=604800
NANOCLAW_CUSTOMER_HARNESS_RESPONSE_CACHE_TTL_SECONDS=300
NANOCLAW_CUSTOMER_HARNESS_SUMMARY_TURNS=15
NANOCLAW_CUSTOMER_HARNESS_RECENT_TURNS=5
NANOCLAW_CUSTOMER_HARNESS_ROUTE_CONFIDENCE=0.70
# Allow confirmed private user memories to be sent to the configured remote model.
NANOCLAW_CUSTOMER_HARNESS_PRIVATE_CONTEXT_TRANSFER_APPROVED=false
NANOCLAW_CUSTOMER_HARNESS_TOOL_TIMEOUT_SECONDS=45
NANOCLAW_CUSTOMER_HARNESS_TOOL_MAX_ATTEMPTS=2
NANOCLAW_CUSTOMER_HARNESS_BACKOFF_BASE_SECONDS=0.5
NANOCLAW_CUSTOMER_HARNESS_CIRCUIT_WINDOW=12
NANOCLAW_CUSTOMER_HARNESS_CIRCUIT_FAILURE_THRESHOLD=8
NANOCLAW_CUSTOMER_HARNESS_CIRCUIT_CONSECUTIVE_FAILURES=5
NANOCLAW_CUSTOMER_HARNESS_CIRCUIT_COOLDOWN_SECONDS=60

# 内部员工 Agent 的 LangGraph 断点。正式运行默认使用 Redis DB 1；客户产品
# 缓存使用 DB 0，二者不混用。成功完成后自动删除，异常断点最多保留 7 天。
EMPLOYEE_AGENT_CHECKPOINT_BACKEND=redis
EMPLOYEE_AGENT_REDIS_URL=redis://127.0.0.1:6379/1
EMPLOYEE_AGENT_CHECKPOINT_TTL_MINUTES=10080
EMPLOYEE_AGENT_REDIS_CONNECT_TIMEOUT_SECONDS=5

# SQLite 只供自动化测试或明确的本地隔离测试使用；选择 sqlite 时才读取此路径。
EMPLOYEE_AGENT_CHECKPOINT_PATH=workspace/internal_agent/checkpoints.sqlite3

# 顺丰国际 Provider 仅预留，尚未实现正式 API 协议，必须保持关闭。
NANOCLAW_CUSTOMER_SHIPPING_ENABLED=false
NANOCLAW_CUSTOMER_SHIPPING_PROVIDER=sf_international
NANOCLAW_SF_INTERNATIONAL_API_BASE_URL=
NANOCLAW_SF_INTERNATIONAL_API_KEY=
NANOCLAW_SF_INTERNATIONAL_MONTHLY_ACCOUNT=

# 客户登录和注册默认关闭。开启登录时必须设置至少 32 位随机 Session 密钥。
NANOCLAW_CUSTOMER_AUTH_ENABLED=false
NANOCLAW_CUSTOMER_REGISTRATION_ENABLED=false
NANOCLAW_CUSTOMER_SESSION_SECRET=replace-with-a-random-64-character-secret
NANOCLAW_CUSTOMER_AUTH_DATABASE_PATH=workspace/customer_auth/customer_auth.db
NANOCLAW_CUSTOMER_DATA_DATABASE_PATH=workspace/customer_data/customer_data.db
NANOCLAW_CUSTOMER_AUTH_IDLE_MINUTES=30
NANOCLAW_CUSTOMER_AUTH_ABSOLUTE_HOURS=12
NANOCLAW_CUSTOMER_ANONYMOUS_CLAIM_ENABLED=true

# =============================================================================
# 七、统一 JWT 请求鉴权（默认关闭；Agent/RAG/工具权限暂不接入）
# =============================================================================

# 开启后，内部工作台 API/WebSocket 必须登录。
NANOCLAW_ACCESS_CONTROL_ENABLED=false
NANOCLAW_ACCESS_AUTH_DATABASE_PATH=workspace/auth/access_control.db
NANOCLAW_ACCESS_TENANT_ID=default
NANOCLAW_JWT_SECRET=
NANOCLAW_JWT_ISSUER=nanoclaw
NANOCLAW_JWT_AUDIENCE=nanoclaw-api
NANOCLAW_JWT_ACCESS_MINUTES=15
NANOCLAW_REFRESH_TOKEN_DAYS=7

# 仅用于首次启动创建内部员工，创建成功后立即从环境中移除密码。
NANOCLAW_BOOTSTRAP_USERNAME=
NANOCLAW_BOOTSTRAP_PASSWORD=
NANOCLAW_BOOTSTRAP_ROLES=employee

# 只启用入口分类与分发；不会改动两个 Agent、RAG 或工具内部实现。
# 留空时使用 config.json 中 models.cheap 指定的小模型。
NANOCLAW_LLM_ROUTING_ENABLED=false
NANOCLAW_LLM_ROUTING_MODEL=

# =============================================================================
# 八、双 Agent 记忆（高级功能，默认关闭）
# =============================================================================

# 总开关关闭时，下面的工作区记忆子功能都不会启用。
NANOCLAW_WORKSPACE_MEMORY_ENABLED=false
NANOCLAW_WORKSPACE_MEMORY_AUTO_EXTRACT_ENABLED=false
NANOCLAW_WORKSPACE_MEMORY_HYBRID_ENABLED=false
NANOCLAW_WORKSPACE_MEMORY_GOVERNANCE_ENABLED=false
NANOCLAW_WORKSPACE_MEMORY_REVIEW_ENABLED=false
NANOCLAW_WORKSPACE_MEMORY_LEGACY_FALLBACK_ENABLED=true

# 默认 local_hash 不会把记忆发送到外部服务。
# 使用外部 Embedding 服务时，需要同时填写地址、模型、密钥并显式批准数据传输。
NANOCLAW_WORKSPACE_MEMORY_EMBEDDING_BACKEND=local_hash
NANOCLAW_WORKSPACE_MEMORY_EMBEDDING_DIMENSIONS=64
NANOCLAW_WORKSPACE_MEMORY_EMBEDDING_BASE_URL=
NANOCLAW_WORKSPACE_MEMORY_EMBEDDING_MODEL=
NANOCLAW_WORKSPACE_MEMORY_EMBEDDING_API_KEY=
NANOCLAW_WORKSPACE_MEMORY_EXTERNAL_TRANSFER_APPROVED=false

# 记忆衰减、复核和后台维护周期。普通使用保持默认值。
NANOCLAW_WORKSPACE_MEMORY_SEMANTIC_HALF_LIFE_DAYS=180
NANOCLAW_WORKSPACE_MEMORY_EPISODIC_HALF_LIFE_DAYS=30
NANOCLAW_WORKSPACE_MEMORY_PROCEDURAL_HALF_LIFE_DAYS=365
NANOCLAW_WORKSPACE_MEMORY_REVIEW_INTERVAL_HOURS=168
NANOCLAW_WORKSPACE_MEMORY_MAINTENANCE_SECONDS=3600

# 记忆管理接口的令牌和允许访问的浏览器来源。
NANOCLAW_WORKSPACE_MEMORY_ADMIN_TOKEN=
NANOCLAW_WORKSPACE_MEMORY_ADMIN_ALLOWED_ORIGINS=

# 客户长期记忆、会话记忆以及工作区读取客户记忆默认关闭。
NANOCLAW_CUSTOMER_LONG_TERM_MEMORY_ENABLED=false
NANOCLAW_CUSTOMER_CONVERSATION_MEMORY_ENABLED=false
NANOCLAW_WORKSPACE_CUSTOMER_MEMORY_READ_ENABLED=false

# 开启工作区读取客户记忆时，必须由可信登录系统提供操作人和租户 ID。
NANOCLAW_WORKSPACE_OPERATOR_ID=
NANOCLAW_WORKSPACE_OPERATOR_TENANT_ID=

# 记忆混合检索参数。local_hash 表示本地计算，不访问外部网络。
NANOCLAW_MEMORY_HYBRID_RETRIEVAL_ENABLED=false
NANOCLAW_MEMORY_LONG_TERM_BACKEND=mysql
NANOCLAW_MEMORY_VECTOR_BACKEND=milvus

# 结构化长期记忆只写入 MySQL。短期工作记忆仍写入上面的 SQLite 数据文件。
NANOCLAW_MEMORY_MYSQL_HOST=127.0.0.1
NANOCLAW_MEMORY_MYSQL_PORT=3307
NANOCLAW_MEMORY_MYSQL_DATABASE=nanoclaw_docker
NANOCLAW_MEMORY_MYSQL_USER=
NANOCLAW_MEMORY_MYSQL_PASSWORD=
NANOCLAW_MEMORY_MYSQL_CONNECT_TIMEOUT_SECONDS=5

# 长期语义索引只写入 Milvus；两个集合按客户/工作区做物理隔离。
NANOCLAW_MEMORY_MILVUS_URI=http://127.0.0.1:19530
NANOCLAW_MEMORY_MILVUS_TOKEN=
NANOCLAW_MEMORY_MILVUS_ADMIN_TOKEN=
NANOCLAW_MEMORY_MILVUS_DATABASE=nanoclaw_vector_docker
NANOCLAW_MEMORY_MILVUS_CUSTOMER_COLLECTION=nanoclaw_customer_memory_v2
NANOCLAW_MEMORY_MILVUS_WORKSPACE_COLLECTION=nanoclaw_workspace_memory_v1

NANOCLAW_MEMORY_EMBEDDING_BACKEND=openai_compatible
NANOCLAW_MEMORY_EMBEDDING_DIMENSIONS=1024
NANOCLAW_MEMORY_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
NANOCLAW_MEMORY_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
NANOCLAW_MEMORY_EMBEDDING_API_KEY=
NANOCLAW_MEMORY_EXTERNAL_TRANSFER_APPROVED=false
NANOCLAW_MEMORY_HYBRID_KEYWORD_WEIGHT=1.0
NANOCLAW_MEMORY_HYBRID_VECTOR_WEIGHT=1.0
NANOCLAW_MEMORY_HYBRID_SCORE_THRESHOLD=0.0

# 记忆治理与保留策略默认关闭，确认组织的数据政策后再开启。
NANOCLAW_MEMORY_GOVERNANCE_ENABLED=false
NANOCLAW_CUSTOMER_ANONYMOUS_RETENTION_DAYS=30
NANOCLAW_PEER_MEMORY_TTL_HOURS=24
NANOCLAW_MEMORY_DELETION_SLA_HOURS=72
NANOCLAW_MEMORY_BACKUP_ENABLED=false
NANOCLAW_MEMORY_MAX_TURNS=10
NANOCLAW_MEMORY_RECALL_TOP_K=3

# 没有在管理界面保存销售邮箱时，使用这里的公共联系邮箱。
NANOCLAW_PUBLIC_SALES_EMAIL=

# =============================================================================
# 八、邮件管理和发送（默认不发送真实邮件）
# =============================================================================

# 内部邮件管理接口令牌。启用相关接口时生成一个较长的随机值。
NANOCLAW_EMAIL_ADMIN_TOKEN=

# 允许访问邮件管理接口的额外浏览器来源，多个地址用英文逗号分隔。
NANOCLAW_EMAIL_ADMIN_ALLOWED_ORIGINS=

# 服务端记录的审核人 ID，浏览器不能自行覆盖。
NANOCLAW_EMAIL_REVIEWER_ID=

# SMTP 发送 Worker 默认关闭。只有账号、收件人白名单和审批流程都验证后再开启。
NANOCLAW_EMAIL_SMTP_WORKER_ENABLED=false
NANOCLAW_EMAIL_SMTP_POLL_SECONDS=5
NANOCLAW_EMAIL_SMTP_TIMEOUT_SECONDS=20
NANOCLAW_EMAIL_SMTP_BATCH_SIZE=10

# =============================================================================
# 九、邮件 RFQ 收取（默认关闭）
# =============================================================================

# 不使用收件箱导入时保持 false，下面的账号信息保持空白。
NANOCLAW_EMAIL_ENABLED=false

NANOCLAW_EMAIL_PROVIDER=qq

NANOCLAW_EMAIL_ACCOUNT_ID=
NANOCLAW_EMAIL_ADDRESS=

NANOCLAW_EMAIL_AUTH_CODE=
NANOCLAW_EMAIL_IMAP_HOST=
NANOCLAW_EMAIL_IMAP_PORT=993
NANOCLAW_EMAIL_FOLDER=INBOX
NANOCLAW_EMAIL_POLL_SECONDS=60
NANOCLAW_EMAIL_MAX_MESSAGE_BYTES=10485760
NANOCLAW_EMAIL_MAX_ATTACHMENTS=10
NANOCLAW_EMAIL_EXTRACTION_TIMEOUT_SECONDS=60

# 收到邮件后的 QQ 通知，默认关闭。
NANOCLAW_EMAIL_QQ_NOTIFY_ENABLED=false
NANOCLAW_EMAIL_QQ_TARGET_ID=
NANOCLAW_EMAIL_QQ_TARGET_TYPE=c2c

# 自动轮询在管理界面保存的健康邮箱账号。
# 默认本地提取器不会把真实邮件正文发送给外部大模型。
NANOCLAW_EMAIL_MANAGED_ACCOUNTS_ENABLED=false
NANOCLAW_EMAIL_MANAGED_SCAN_SECONDS=5
NANOCLAW_EMAIL_REMOTE_EXTRACTION_APPROVED=false
NANOCLAW_EMAIL_CLARIFICATION_AUTO_REPLY_ENABLED=false

# =============================================================================
# 十、产品知识库 Embedding、查询改写和 Rerank API
# =============================================================================

# 产品知识库入库与检索使用同一个千问3 Embedding 模型；密钥由部署者填写。
# 启用外部请求前还需将 RAG_REMOTE_DATA_TRANSFER_APPROVED 设为 true。
RAG_EMBEDDING_PROVIDER=qwen3
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
RAG_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
RAG_EMBEDDING_DIMENSIONS=1024
RAG_EMBEDDING_TIMEOUT_SECONDS=30
RAG_EMBEDDING_BATCH_SIZE=32

# 千问3 8B 负责把用户问题改写为最多 3 条检索查询；密钥后续填写。
RAG_QUERY_REWRITE_PROVIDER=qwen3
RAG_QUERY_REWRITE_API_KEY=
RAG_QUERY_REWRITE_BASE_URL=https://api.siliconflow.cn/v1
RAG_QUERY_REWRITE_MODEL=Qwen/Qwen3-8B
RAG_QUERY_REWRITE_TIMEOUT_SECONDS=15
RAG_QUERY_REWRITE_NUM_QUERIES=3

# 千问负责依据检索证据生成产品/售后回答；密钥后续填写。
RAG_GENERATION_PROVIDER=qwen3
RAG_GENERATION_API_KEY=
RAG_GENERATION_BASE_URL=https://api.siliconflow.cn/v1
RAG_GENERATION_MODEL=Qwen/Qwen3-8B
RAG_GENERATION_TIMEOUT_SECONDS=20
RAG_GENERATION_MAX_CONTEXTS=5
RAG_GENERATION_MAX_CONTEXT_CHARS=1800
RAG_GENERATION_MAX_OUTPUT_TOKENS=400

# 千问3 精排模型。密钥后续填写；未配置或请求失败时保持原召回顺序。
RAG_RERANK_PROVIDER=qwen3
RAG_RERANK_API_KEY=
RAG_RERANK_BASE_URL=https://api.siliconflow.cn/v1
RAG_RERANK_MODEL=Qwen/Qwen3-Reranker-8B
RAG_RERANK_TIMEOUT_SECONDS=30
RAG_RERANK_MAX_CANDIDATES=30

# 只有确认允许知识片段、用户查询及其对话历史发送到外部服务时才改为 true。
RAG_REMOTE_DATA_TRANSFER_APPROVED=false

# =============================================================================
# 十一、PDF 和图片 OCR
# =============================================================================

# OCR 模型固定放在项目根目录 .paddlex。
# 交付项目时可以直接复制该目录，使对方无需重新下载模型。
PADDLE_PDX_CACHE_HOME=.paddlex
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
HF_HOME=.paddlex/huggingface
MODELSCOPE_HOME=.paddlex/modelscope
MODELSCOPE_CACHE=.paddlex/modelscope/hub

# 图片默认交给 Qwen-VL 识别可见文字并描述产品图示；仅图片会发送到视觉 API。
# API Key 和 Base URL 默认复用 RAG_EMBEDDING_*；也可单独设置 RAG_VISION_*。
RAG_OCR_ENABLED=true
RAG_OCR_PROVIDER=qwen_vl
RAG_OCR_LANGUAGE=ch
RAG_OCR_DEVICE=cpu
RAG_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
RAG_PDF_AUTO_ACCEPT_SAFE_REVIEW=false
RAG_VISION_BASE_URL=
RAG_VISION_API_KEY=
# 显式允许将知识库中的图片发送给配置的 Qwen 视觉模型。
RAG_VISION_REMOTE_APPROVED=false

# PaddleOCR 的置信度阈值；Qwen-VL 图片解析结果有文本时直接进入索引。
RAG_OCR_MIN_CONFIDENCE=0.60

# OCR 安全限制。普通使用保持默认值。
RAG_OCR_MAX_IMAGES_PER_DOCUMENT=300
RAG_OCR_MAX_CONCURRENT_IMAGES=4
RAG_VISION_TIMEOUT_SECONDS=30
RAG_VISION_MAX_TOKENS=900
RAG_VISION_MAX_ATTEMPTS=1
RAG_OCR_MAX_IMAGE_BYTES=20971520
RAG_OCR_MAX_IMAGE_PIXELS=40000000
RAG_OCR_MAX_CHARS_PER_IMAGE=20000
RAG_OCR_PDF_DPI=200
RAG_OCR_MIN_EMBEDDED_WIDTH=64
RAG_OCR_MIN_EMBEDDED_HEIGHT=64

# PDF 安全限制：默认最大 20 MB、最多 300 页。
RAG_PDF_MAX_BYTES=20971520
RAG_PDF_MAX_PAGES=300
RAG_PDF_MAX_CHARS_PER_PAGE=200000
RAG_PDF_MAX_TOTAL_CHARS=5000000
RAG_PDF_PARSE_TIMEOUT_SECONDS=30
RAG_PDF_MAX_CONCURRENT_PARSES=2
RAG_PDF_MIN_TEXT_PAGE_RATIO=0.8
RAG_PDF_MIN_AVERAGE_CHARS_PER_TEXT_PAGE=50
RAG_PDF_MAX_CONSECUTIVE_BLANK_PAGES=3

# =============================================================================
# 十二、共享运行时（普通单机运行保持默认值）
# =============================================================================

NANOCLAW_GATEWAY_MAX_CONCURRENCY=16
NANOCLAW_RUNTIME_COORDINATOR_BACKEND=memory
NANOCLAW_CONVERSATION_BACKEND=local

# Inquiry workflow: Redis working memory / business DB reports / S3 originals
INQUIRY_WORKFLOW_ENABLED=true
INQUIRY_TENANT_ID=default
# 面试演示保障。开启后外部接口失败会切换到明确标记的本地演示数据。
DEMO_MODE=false
# true 表示完全跳过外部接口，适合无网络的现场演示；false 表示真实接口优先。
DEMO_PREFER_FIXTURES=false
DEMO_LIVE_MAILBOX=false
DEMO_EXTERNAL_TIMEOUT_SECONDS=8
DEMO_EXTERNAL_RETRIES=1
DEMO_REPORT_TIMEOUT_SECONDS=45
# 演示邮件原件和已审批的模拟回复会以 .eml 文件保存到 runtime/demo-mailbox。
# 演示样例始终保存在本地；真实来信在 SMTP 未开启时也保存为本地模拟回复。
DUE_DILIGENCE_REDIS_URL=redis://127.0.0.1:6379/3
DUE_DILIGENCE_MEMORY_TTL_SECONDS=86400
DUE_DILIGENCE_MAX_STEPS=6
# Plan-and-Execute 背调：搜索、官网受控爬取、地图、企业级海关和新闻。
# search_provider 可选 tavily 或 brave；密钥暂时留空时，报告会明确标记对应调查缺口。
DUE_DILIGENCE_SEARCH_PROVIDER=tavily
DUE_DILIGENCE_SEARCH_API_KEY=
TAVILY_API_KEY=
DUE_DILIGENCE_MAPS_API_KEY=
# 留空时自动使用低频、带缓存的 OpenStreetMap Nominatim 演示查询；
# 填写 Google Places Key 后自动优先使用 Google。
DUE_DILIGENCE_CUSTOMS_API_KEY=
# BillOfLadingData：先用免费公司搜索确认主体，再按方向各取少量企业级提单。
DUE_DILIGENCE_CUSTOMS_BASE_URL=https://tradedata.billofladingdata.com
DUE_DILIGENCE_CUSTOMS_PROVIDER=billofladingdata
DUE_DILIGENCE_CUSTOMS_RECORDS_PER_DIRECTION=3
DUE_DILIGENCE_NEWS_API_KEY=
DUE_DILIGENCE_CRAWL_MAX_PAGES=12
DUE_DILIGENCE_CRAWL_MAX_DEPTH=2
# 最终背调报告单独使用 DeepSeek V4 Pro；未填写 Key 时暂时回退到主模型。
DUE_DILIGENCE_REPORT_BASE_URL=https://api.deepseek.com
DUE_DILIGENCE_REPORT_MODEL=deepseek-v4-pro
DUE_DILIGENCE_REPORT_API_KEY=
DUE_DILIGENCE_REPORT_MAX_TOKENS=8192
DUE_DILIGENCE_REPORT_TIMEOUT_SECONDS=180
DUE_DILIGENCE_REPORT_MAX_RETRIES=2
DUE_DILIGENCE_REPORT_REPAIR_ATTEMPTS=1
DUE_DILIGENCE_REPORT_REASONING_EFFORT=high
DUE_DILIGENCE_REPORT_FALLBACK_MODEL=deepseek-flash
DUE_DILIGENCE_REPORT_FALLBACK_MAX_RETRIES=1
EMAIL_S3_BUCKET=
EMAIL_S3_ENDPOINT_URL=
EMAIL_S3_PREFIX=nanoclaw/email
EMAIL_S3_KMS_KEY_ID=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
INQUIRY_SMTP_ENABLED=false

# Customer long-term memory
NANOCLAW_MEMORY_MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
