# PaddleX runtime cache. Keep only the three OCR models required for offline
# delivery; ignore server models, download locks, temporary files and caches.
.paddlex/*
!.paddlex/official_models/
.paddlex/official_models/*
!.paddlex/official_models/PP-OCRv5_mobile_det/
!.paddlex/official_models/PP-OCRv5_mobile_det/**
!.paddlex/official_models/PP-OCRv5_mobile_rec/
!.paddlex/official_models/PP-OCRv5_mobile_rec/**
!.paddlex/official_models/PP-LCNet_x1_0_textline_ori/
!.paddlex/official_models/PP-LCNet_x1_0_textline_ori/**

