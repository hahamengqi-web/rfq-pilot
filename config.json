{
  "base_url": "https://api.siliconflow.cn/v1",
  "models": {
    "main": "zai-org/GLM-5.2",
    "subagent": "deepseek-ai/DeepSeek-V4-Pro",
    "cheap": "deepseek-ai/DeepSeek-V4-Flash"
  },
  "workspace": ".",
  "max_iterations": 32,
  "identity_file": "prompts/internal_employee.md",
  "web": {
    "enabled": false,
    "host": "127.0.0.1",
    "port": 8765
  },
  "workspace_web": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 8767
  },
  "customer_portal": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 8766,
    "public_url": "",
    "identity_file": "prompts/customer_consultation.md",
    "session_dir": "workspace/customer_sessions",
    "memory_enabled": true,
    "memory_file": "workspace/customer_memory/PUBLIC_MEMORY.md"
  },
  "access_control": {
    "enabled": false,
    "database_path": "workspace/auth/access_control.db",
    "tenant_id": "default",
    "issuer": "nanoclaw",
    "audience": "nanoclaw-api",
    "access_minutes": 15,
    "refresh_days": 7
  },
  "agent_routing": {
    "enabled": false,
    "model": ""
  },
  "mcp_servers": {
    "foreign_trade_inquiry": {
      "command": "{python}",
      "args": ["-m", "mcp_servers.foreign_trade_inquiry_server"],
      "description": "Foreign trade inquiry and quotation business server",
      "enabled": false
    },
    "inquiry_workflow_tools": {
      "command": "{python}",
      "args": ["-m", "mcp_servers.inquiry_workflow_tools_server"],
      "env_prefixes": ["DUE_DILIGENCE_", "TAVILY_", "DEMO_", "TRADE_OPS_MYSQL_", "NANOCLAW_MYSQL_", "BUSINESS_DATABASE_"],
      "description": "Auditable due diligence, catalog and deterministic quote MCP tools",
      "enabled": true
    },
    "trade_rag": {
      "command": "{python}",
      "args": ["-m", "trade_rag.server"],
      "description": "Enterprise knowledge-base RAG MCP server",
      "enabled": true
    }
  }
}
