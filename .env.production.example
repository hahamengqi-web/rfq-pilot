# Agreed production storage profile. Copy values into the real secret environment.
NANOCLAW_STORAGE_PROFILE=production

# One MySQL schema is the authority for trade/email, conversations, structured
# long-term memory, knowledge metadata and indexing jobs.
NANOCLAW_MYSQL_HOST=127.0.0.1
NANOCLAW_MYSQL_PORT=3307
NANOCLAW_MYSQL_DATABASE=nanoclaw_docker
NANOCLAW_MYSQL_USER=nanoclaw_docker
NANOCLAW_MYSQL_PASSWORD=replace-with-a-long-random-password
BUSINESS_DATABASE_BACKEND=mysql
NANOCLAW_CONVERSATION_BACKEND=mysql
RAG_METADATA_BACKEND=mysql

# Milvus contains semantic vectors only; MySQL remains the source of truth.
NANOCLAW_MILVUS_URI=http://127.0.0.1:19530
NANOCLAW_MILVUS_TOKEN=nanoclaw_rag:replace-with-a-long-random-password
NANOCLAW_MILVUS_DATABASE=nanoclaw_vector_docker
RAG_VECTOR_BACKEND=milvus
RAG_MILVUS_COLLECTION_ALIAS=trade_knowledge_active
NANOCLAW_MEMORY_VECTOR_BACKEND=milvus
NANOCLAW_MEMORY_MILVUS_CUSTOMER_COLLECTION=nanoclaw_customer_memory_v1
NANOCLAW_MEMORY_MILVUS_WORKSPACE_COLLECTION=nanoclaw_workspace_memory_v1

# Elasticsearch is used only for enterprise-knowledge BM25.
NANOCLAW_ELASTICSEARCH_URL=http://127.0.0.1:9201
NANOCLAW_ELASTICSEARCH_USERNAME=elastic
NANOCLAW_ELASTICSEARCH_PASSWORD=replace-with-a-long-random-password
NANOCLAW_ELASTICSEARCH_INDEX=trade_knowledge_child_v1
RAG_KEYWORD_BACKEND=elasticsearch

# Full long-term memory path. SQLite working-memory files remain local.
NANOCLAW_MEMORY_LONG_TERM_BACKEND=mysql
NANOCLAW_WORKSPACE_MEMORY_ENABLED=true
NANOCLAW_WORKSPACE_MEMORY_HYBRID_ENABLED=true
NANOCLAW_MEMORY_HYBRID_RETRIEVAL_ENABLED=true
NANOCLAW_WORKSPACE_MEMORY_LEGACY_FALLBACK_ENABLED=false
NANOCLAW_CUSTOMER_AUTH_ENABLED=true
NANOCLAW_CUSTOMER_PRODUCT_LANGCHAIN_ENABLED=true
NANOCLAW_CUSTOMER_PRODUCT_REDIS_URL=redis://redis:6379/0
EMPLOYEE_AGENT_CHECKPOINT_BACKEND=redis
EMPLOYEE_AGENT_REDIS_URL=redis://redis:6379/1
NANOCLAW_EMAIL_CLARIFICATION_AUTO_REPLY_ENABLED=false
EMPLOYEE_AGENT_CHECKPOINT_TTL_MINUTES=10080
EMPLOYEE_AGENT_REDIS_CONNECT_TIMEOUT_SECONDS=5
NANOCLAW_CUSTOMER_PRODUCT_CACHE_PREFIX=nanoclaw:customer-product
NANOCLAW_CUSTOMER_PRODUCT_CACHE_TTL_SECONDS=300
NANOCLAW_CUSTOMER_PRODUCT_RATE_LIMIT_PER_MINUTE=60
NANOCLAW_CUSTOMER_PRODUCT_DATA_VERSION=products-v1
NANOCLAW_CUSTOMER_PRODUCT_DEFAULT_LEVEL=standard
NANOCLAW_CUSTOMER_PRODUCT_DEFAULT_REGION=GLOBAL
NANOCLAW_CUSTOMER_PRODUCT_DEFAULT_CURRENCY=USD
NANOCLAW_CUSTOMER_SHIPPING_ENABLED=false
NANOCLAW_CUSTOMER_SHIPPING_PROVIDER=sf_international
NANOCLAW_SF_INTERNATIONAL_API_BASE_URL=
NANOCLAW_SF_INTERNATIONAL_API_KEY=
NANOCLAW_SF_INTERNATIONAL_MONTHLY_ACCOUNT=
NANOCLAW_CUSTOMER_SESSION_SECRET=replace-with-at-least-32-random-characters
NANOCLAW_ACCESS_CONTROL_ENABLED=true
NANOCLAW_JWT_SECRET=replace-with-a-different-random-secret-at-least-32-characters
NANOCLAW_JWT_ACCESS_MINUTES=15
NANOCLAW_REFRESH_TOKEN_DAYS=7
# Set these only for the first boot, then remove the password from the environment.
NANOCLAW_BOOTSTRAP_USERNAME=admin@example.com
NANOCLAW_BOOTSTRAP_PASSWORD=replace-with-a-strong-bootstrap-password
NANOCLAW_BOOTSTRAP_ROLES=admin
NANOCLAW_LLM_ROUTING_ENABLED=true
# Leave empty to use models.cheap from config.json.
NANOCLAW_LLM_ROUTING_MODEL=
NANOCLAW_CUSTOMER_CONVERSATION_MEMORY_ENABLED=true
NANOCLAW_CUSTOMER_LONG_TERM_MEMORY_ENABLED=true
NANOCLAW_WORKSPACE_OPERATOR_ID=replace-with-service-operator-id
NANOCLAW_WORKSPACE_OPERATOR_TENANT_ID=replace-with-tenant-id

# Durable file/object-storage mount for originals and parsed artifacts.
NANOCLAW_KNOWLEDGE_FILE_ROOT=workspace/knowledge_base

# Inquiry workflow: Redis working memory / business DB reports / S3 originals
INQUIRY_WORKFLOW_ENABLED=true
INQUIRY_TENANT_ID=default
# 生产环境必须保持关闭；该开关仅用于可识别的面试演示数据。
DEMO_MODE=false
DEMO_PREFER_FIXTURES=false
DEMO_LIVE_MAILBOX=false
DEMO_EXTERNAL_TIMEOUT_SECONDS=8
DEMO_EXTERNAL_RETRIES=1
DEMO_REPORT_TIMEOUT_SECONDS=45
DUE_DILIGENCE_REDIS_URL=redis://127.0.0.1:6379/3
DUE_DILIGENCE_MEMORY_TTL_SECONDS=86400
DUE_DILIGENCE_MAX_STEPS=6
DUE_DILIGENCE_SEARCH_PROVIDER=tavily
DUE_DILIGENCE_SEARCH_API_KEY=
TAVILY_API_KEY=
DUE_DILIGENCE_MAPS_API_KEY=
DUE_DILIGENCE_CUSTOMS_API_KEY=
DUE_DILIGENCE_CUSTOMS_BASE_URL=https://tradedata.billofladingdata.com
DUE_DILIGENCE_CUSTOMS_PROVIDER=billofladingdata
DUE_DILIGENCE_CUSTOMS_RECORDS_PER_DIRECTION=3
DUE_DILIGENCE_NEWS_API_KEY=
DUE_DILIGENCE_CRAWL_MAX_PAGES=12
DUE_DILIGENCE_CRAWL_MAX_DEPTH=2
DUE_DILIGENCE_REPORT_BASE_URL=https://api.deepseek.com
DUE_DILIGENCE_REPORT_MODEL=deepseek-v4-pro
DUE_DILIGENCE_REPORT_API_KEY=
DUE_DILIGENCE_REPORT_MAX_TOKENS=8192
DUE_DILIGENCE_REPORT_TIMEOUT_SECONDS=180
DUE_DILIGENCE_REPORT_MAX_RETRIES=2
DUE_DILIGENCE_REPORT_REPAIR_ATTEMPTS=1
DUE_DILIGENCE_REPORT_REASONING_EFFORT=high
DUE_DILIGENCE_REPORT_FALLBACK_MODEL=deepseek-flash
DUE_DILIGENCE_REPORT_FALLBACK_MAX_RETRIES=1
EMAIL_S3_BUCKET=
EMAIL_S3_ENDPOINT_URL=
EMAIL_S3_PREFIX=nanoclaw/email
EMAIL_S3_KMS_KEY_ID=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
INQUIRY_SMTP_ENABLED=false
